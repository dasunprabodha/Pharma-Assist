# Copy this file to .env (which is git-ignored) and fill in your values.
# Do NOT put AWS access keys here. Credentials come from the standard AWS chain
# (an `aws configure --profile prescription-reader` profile, or SSO).

# Region where Amazon Nova is available on Bedrock
AWS_REGION=us-east-1

# Named AWS CLI profile holding the least-privilege dev credentials (optional)
AWS_PROFILE=prescription-reader

# Bedrock model / inference profile ID (default: Amazon Nova 2 Lite, US cross-region profile)
# Can be switched to another Bedrock vision model, e.g. us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Optional: USD per 1M tokens for the dashboard's cost estimate (defaults: Nova 2 Lite, US inference profile)
# PRICE_INPUT_PER_1M=0.33
# PRICE_OUTPUT_PER_1M=2.75
