/*.pdf
/*.docx
/*.pptx
/CLAUDE(1).md

# AWS CLI installer leftovers
/aws/
/awscliv2.zip

# Real (dataset) prescription images - not synthetic, keep out of the public repo
/Samples Prescriptions/
/Samples Sri Lanka/

