backend/target/

# Frontend (Angular)
frontend/node_modules/
frontend/dist/
frontend/.angular/

# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store

# Student's own coursework documents (kept locally, not part of the source)
/*.pdf
/*.docx
/*.pptx
/CLAUDE(1).md
